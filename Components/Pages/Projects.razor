@page "/projects"
@rendermode InteractiveServer
@using ProjectIntelligence.Models
@using ProjectIntelligence.Services
@inject IProjectService ProjectSvc

<h3>Projects</h3>

<div class="card mb-4">
    <div class="card-body">
        <h5>@(currentProject.Id == 0 ? "Add New Project" : "Edit Project")</h5>
        <EditForm Model="currentProject" OnValidSubmit="HandleSubmit">
            <DataAnnotationsValidator />
            <ValidationSummary />

            <div class="row g-3">
                <div class="col-md-4">
                    <label class="form-label">Name</label>
                    <InputText @bind-Value="currentProject.Name" class="form-control" />
                </div>
                <div class="col-md-4">
                    <label class="form-label">Status</label>
                    <InputSelect @bind-Value="currentProject.Status" class="form-select">
                        @foreach (var s in Enum.GetValues<ProjectStatus>())
                        {
                            <option value="@s">@s</option>
                        }
                    </InputSelect>
                </div>
                <div class="col-md-4">
                    <label class="form-label">Start Date</label>
                    <InputDate @bind-Value="currentProject.StartDate" class="form-control" />
                </div>
                <div class="col-md-4">
                    <label class="form-label">End Date</label>
                    <InputDate @bind-Value="currentProject.EndDate" class="form-control" />
                </div>
                <div class="col-md-8">
                    <label class="form-label">Description</label>
                    <InputText @bind-Value="currentProject.Description" class="form-control" />
                </div>
                <div class="col-12 mt-3">
                    <button type="submit" class="btn btn-success">Save Project</button>
                    @if (currentProject.Id != 0)
                    {
                        <button type="button" class="btn btn-secondary ms-2" @onclick="CancelEdit">Cancel</button>
                    }
                </div>
            </div>
        </EditForm>
    </div>
</div>

<div class="mb-3 d-flex gap-2">
    <input type="text" @bind="nameFilter" class="form-control w-25" placeholder="Filter by name" />
    <select @bind="statusFilter" class="form-select w-25">
        <option value="">All statuses</option>
        @foreach (var s in Enum.GetValues<ProjectStatus>())
        {
            <option value="@s">@s</option>
        }
    </select>
    <button class="btn btn-primary" @onclick="Load">Filter</button>
</div>

<table class="table table-hover">
    <thead class="table-light">
        <tr>
            <th>Name</th>
            <th>Status</th>
            <th>Start</th>
            <th>End</th>
            <th>Delayed?</th>
            <th>Actions</th>
        </tr>
    </thead>
    <tbody>
        @foreach (var p in projects)
        {
            <tr>
                <td>@p.Name</td>
                <td>@p.Status</td>
                <td>@p.StartDate.ToShortDateString()</td>
                <td>@p.EndDate.ToShortDateString()</td>
                <td>
                    @if (p.IsDelayed)
                    {
                        <span class="badge bg-danger">⚠️ Delayed</span>
                    }
                    else
                    {
                        <span class="badge bg-success">No</span>
                    }
                </td>
                <td>
                    <button class="btn btn-sm btn-outline-primary" @onclick="() => EditProject(p)">Edit</button>
                    <button class="btn btn-sm btn-outline-danger ms-1" @onclick="() => DeleteProject(p.Id)">Delete</button>
                </td>
            </tr>
        }
    </tbody>
</table>

@code {
    private List<Project> projects = new();
    private string? nameFilter;
    private string? statusFilter;
    private Project currentProject { get; set; } = new() { StartDate = DateTime.Today, EndDate = DateTime.Today.AddMonths(1) };

    protected override async Task OnInitializedAsync() => await Load();

    private async Task Load()
    {
        ProjectStatus? status = string.IsNullOrEmpty(statusFilter) ? null : Enum.Parse<ProjectStatus>(statusFilter);
        projects = await ProjectSvc.GetAllAsync(nameFilter, status);
    }

    private async Task HandleSubmit()
    {
        if (currentProject.Id == 0)
            await ProjectSvc.CreateAsync(currentProject);
        else
            await ProjectSvc.UpdateAsync(currentProject);

        currentProject = new() { StartDate = DateTime.Today, EndDate = DateTime.Today.AddMonths(1) };
        await Load();
    }

    private void EditProject(Project p)
    {
        // Shallow copy for editing
        currentProject = new Project
        {
            Id = p.Id,
            Name = p.Name,
            Description = p.Description,
            StartDate = p.StartDate,
            EndDate = p.EndDate,
            Status = p.Status
        };
    }

    private void CancelEdit()
    {
        currentProject = new() { StartDate = DateTime.Today, EndDate = DateTime.Today.AddMonths(1) };
    }

    private async Task DeleteProject(int id)
    {
        if (await ProjectSvc.DeleteAsync(id))
            await Load();
    }
}